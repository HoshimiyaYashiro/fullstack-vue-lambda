{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@repo/tsconfig/vue.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "types": ["vue-router/auto", "node", "vite/client", "vue-macros/macros-global"],
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*", "src/**/*.vue", "vite.config.ts", "playwright.config.ts", "e2e/**/*"]
}
