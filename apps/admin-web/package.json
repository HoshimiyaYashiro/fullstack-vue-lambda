    "@vueuse/core": "^14.4.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.13",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@repo/tsconfig": "workspace:*",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "rimraf": "^6.0.1",
    "typescript": "^6.0.3",
    "vite": "^6.2.0",
    "vue-macros": "^3.1.4",
    "vue-tsc": "^3.3.11"
