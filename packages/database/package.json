  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@types/node": "^22.13.9",
    "drizzle-kit": "^0.31.11",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^6.0.3"
