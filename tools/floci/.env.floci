# ==============================================================================
# Floci Local Cloud Emulation Environment Variables
# ==============================================================================

# AWS General Configuration (Dummy credentials for local emulation)
AWS_REGION=ap-southeast-1
AWS_DEFAULT_REGION=ap-southeast-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Database Configuration (Aurora Serverless v2 PostgreSQL emulation)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/enterprise_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=enterprise_db
POSTGRES_PORT=5432

# Floci Container Settings
FLOCI_STORAGE_MODE=persistent
FLOCI_SERVICES_LAMBDA_HOT_RELOAD_ENABLED=true

# Amazon Cognito
COGNITO_USER_POOL_NAME=enterprise-user-pool
COGNITO_CLIENT_NAME=enterprise-web-client

# Amazon S3 Buckets
S3_PUBLIC_ASSETS_BUCKET=enterprise-public-assets
S3_PRIVATE_UPLOADS_BUCKET=enterprise-private-uploads
S3_EXPORT_REPORTS_BUCKET=enterprise-export-reports

# Amazon DynamoDB Tables
DYNAMODB_TABLE_NAME=enterprise-app-table
DYNAMODB_AUDIT_TABLE=enterprise-audit-logs

# Amazon EventBridge & SNS Messaging
EVENT_BUS_NAME=enterprise-event-bus
SNS_NOTIFICATIONS_TOPIC=enterprise-notifications.fifo
SNS_ALERTS_TOPIC=enterprise-system-alerts
SQS_WORKER_QUEUE=enterprise-worker-queue
SQS_DLQ=enterprise-dlq

# Amazon ECS Fargate
ECS_CLUSTER_NAME=enterprise-fargate-cluster
ECS_TASK_FAMILY=enterprise-worker-task
