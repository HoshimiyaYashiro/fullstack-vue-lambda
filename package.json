{
  "name": "fullstack-vue-lambda",
  "private": true,
  "version": "1.0.0",
  "description": "Enterprise Turborepo monorepo with Vue 3 (User & Admin apps), AWS Lambda Node.js backend, and Biome",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:backend": "node tools/floci/scripts/floci-runner.mjs up && turbo run dev --filter=@repo/worker-lambda",
    "dev:user": "turbo run dev --filter=@repo/user-web",
    "dev:admin": "turbo run dev --filter=@repo/admin-web",
    "dev:lambda": "turbo run dev --filter=@repo/worker-lambda",
    "dev:fargate": "turbo run dev --filter=@repo/worker-fargate",
    "db:migrate": "pnpm --filter @repo/worker-lambda db:migrate",
    "floci:up": "node tools/floci/scripts/floci-runner.mjs up",
    "floci:down": "node tools/floci/scripts/floci-runner.mjs down",
    "floci:logs": "node tools/floci/scripts/floci-runner.mjs logs",
    "floci:seed": "node tools/floci/scripts/floci-runner.mjs seed",
    "floci:doctor": "node tools/floci/scripts/floci-runner.mjs doctor",
    "build": "turbo run build",
    "build:user": "turbo run build --filter=@repo/user-web",
    "build:admin": "turbo run build --filter=@repo/admin-web",
    "build:lambda": "turbo run build --filter=@repo/worker-lambda",
    "build:lambda:handlers": "pnpm --filter=@repo/worker-lambda build:handlers",
    "build:lambda:handler": "pnpm --filter=@repo/worker-lambda build:handler",
    "build:lambda:layer": "pnpm --filter=@repo/worker-lambda build:layer",
    "build:fargate": "turbo run build --filter=@repo/worker-fargate",
    "docker:fargate": "docker build -t enterprise-worker:latest -f apps/worker-fargate/Dockerfile .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "turbo run type-check",
    "clean": "turbo run clean",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:user": "turbo run test:e2e --filter=@repo/user-web",
    "test:e2e:admin": "turbo run test:e2e --filter=@repo/admin-web"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "turbo": "^2.4.4",
    "typescript": "^6.0.3"
  }
}
